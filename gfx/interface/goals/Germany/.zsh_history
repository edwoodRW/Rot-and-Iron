: 1773183611:0;python - <<'PY'\
import os,re,glob\
bkp_dirs = sorted(glob.glob('_recovery_backups/history_countries_*'))\
if not bkp_dirs:\
    raise SystemExit('No backup found')\
bkp = bkp_dirs[-1]\
print('Using backup:', bkp)\
\
def extract_block(text, start_token):\
    idx = text.find(start_token)\
    if idx == -1:\
        return None\
    depth = 0\
    start = None\
    for i in range(idx, len(text)):\
        if text[i] == '{':\
            depth += 1\
            if start is None:\
                start = i\
        elif text[i] == '}':\
            depth -= 1\
            if depth == 0 and start is not None:\
                return text[start:i+1]\
    return None\
\
for path in glob.glob('history/countries/*.txt'):\
    base_name = os.path.basename(path)\
    tag = base_name.split(' ',1)[0]\
    if tag == 'ENG':\
        continue\
    src = os.path.join(bkp, base_name)\
    if not os.path.exists(src):\
        print('Missing backup for', base_name)\
        continue\
    with open(src, 'r', encoding='utf-8', errors='ignore') as f:\
        data = f.read()\
    m = re.search(r'^\s*capital\s*=\s*(\d+)', data, re.M)\
    capital = m.group(1) if m else '1'\
    sp = extract_block(data, 'set_politics')\
    ccl = None\
    ccl_idx = data.find('create_country_leader')\
    if ccl_idx != -1:\
        ccl_block = extract_block(data[ccl_idx:], 'create_country_leader')\
        if ccl_block:\
            ccl = 'create_country_leader ' + ccl_block\
    with open(path, 'w', encoding='utf-8') as out:\
        out.write('# Rebuilt minimal stub with politics/leader from backup\n')\
        out.write(f'capital = {capital}\n\n')\
        if sp:\
            out.write('set_politics ' + sp + '\n\n')\
        else:\
            out.write('set_politics = {\n    ruling_party = neutrality\n    elections_allowed = yes\n}\n\n')\
        if ccl:\
            out.write(ccl + '\n')\
        else:\
            out.write('# (no leader found in backup)\n')\
    print('Rebuilt', path)\
PY
