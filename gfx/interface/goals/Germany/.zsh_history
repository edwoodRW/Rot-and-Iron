: 1790615784:0;cd "/home/ed/.local/share/Paradox Interactive/Hearts of Iron IV/mod/Rot and Iron"\
\
# Check for duplicate state IDs across all state files\
grep -h "^\s*id\s*=" history/states/*.txt | sort | uniq -d\
\
# Check for duplicate province numbers used across different state files\
# (each province should only appear in ONE state file)\
grep -A2 "provinces" history/states/*.txt | grep -oP '\b\d{1,5}\b' | sort | uniq -d\
\
# Find any self-referential transfer (owner and transfer_state_to matching, like the Stanleyville bug)\
for f in history/states/*.txt; do\
  owner=$(grep -oP 'owner\s*=\s*\K\w+' "$f" | head -1)\
  transfer=$(grep -oP 'transfer_state_to\s*=\s*\K\w+' "$f")\
  if [ -n "$transfer" ] && [ "$owner" == "$transfer" ]; then\
    echo "SELF-TRANSFER FOUND: $f (owner=$owner, transfer_state_to=$transfer)"\
  fi\
done\
\
# All AFC and PRC owned states, for a full list\
grep -l "owner = AFC" history/states/*.txt\
grep -l "owner = PRC" history/states/*.txt
