  [ -z "$capital" ] && capital=1\
  rparty=$(grep -m1 "ruling_party" "$f" | awk '{print $3}')\
  [ -z "$rparty" ] && rparty=neutrality\
  cp "$f" "$bkp/$base"\
  cat > "$f" <<EOF\
# Minimal stub autogenerated ${stamp}\
capital = ${capital}\
\
set_politics = {\
    ruling_party = ${rparty}\
    elections_allowed = yes\
}\
EOF\
done
